{"overview":"اين مینی سريال ماجراي گروهاني از نيروهاي چترباز آمريکايي را از دوران آموزش در آمريکا و انگليس تا پايان جنگ‌ جهاني دوم در آلمان تعقيب مي‌کند. ماجرا کاملا بر اساس واقعيت است و به نحوي که در انتهاي هر قسمت کهنه سربازهايي که در سريال دوران جواني آنها را مي‌بينيم، هر کدام چند جمله‌اي مرتبط با مضمون سریال توضيح مي‌دهند.","tagline":"","runtime":null,"status":"Ended","seasons":[{"n":0,"name":"ویژه‌ها","ep":6,"y":2001,"poster":"/h3QMxv1JYozrFQCbPNxnP7x7F6b.jpg"},{"n":1,"name":"فصل 1","ep":10,"y":2001,"poster":"/1dTx3cRcSpaOCe0mXOVEBjz25z3.jpg"}],"episodes":10,"crew":[],"countries":["US"],"cast":[{"name":"Michael Cudlitz","role":"Denver (Bull) Randleman","photo":"/1snLOta9L2DAhmOTvNIn7OSxzQC.jpg"},{"name":"Rick Gomez","role":"George Luz","photo":"/gmVYPHJgmRVIzhaVYMns4kgBVqm.jpg"},{"name":"Scott Grimes","role":"Donald G. Malarkey","photo":"/k5OCDhwZoFuNtN0o4EDkpBXQsFp.jpg"},{"name":"دامیان لوئیس","role":"Richard D. Winters","photo":"/puOXtVatFnAxoOmsFO8z7KTfyJW.jpg"},{"name":"Ron Livingston","role":"Lewis Nixon","photo":"/pr5CjWnkaf5WKTIYh8wtNufjmyb.jpg"},{"name":"James Madio","role":"Frank J. Perconte","photo":"/v17uyHhMLooVWKjMRS4NoGeTPyB.jpg"},{"name":"Neal McDonough","role":"Lynn D. (Buck) Compton","photo":"/3mI3i1CpjATSCta1Tb2qsyl1KCh.jpg"},{"name":"دونی والبرگ","role":"C. Carwood Lipton","photo":"/8OQTlgl7eGAFlKTF2o8rZZT0MoF.jpg"}],"trailer":"KKRBAFlN5ww","watch":{"US":{"link":"https://www.themoviedb.org/tv/4613-band-of-brothers/watch?locale=US","p":[{"n":"HBO Max Amazon Channel","kind":"flatrate","logo":"/64fLWeSyZ1KQZhIdvTdy4QHeWty.png"},{"n":"HBO Max","kind":"flatrate","logo":"/skypuy7SXuugIQeYg0IglmzoKaS.png"},{"n":"Amazon Video","kind":"buy","logo":"/jn6TLbtaTZntTRX9UYucHJvpQx1.png"},{"n":"Apple TV Store","kind":"buy","logo":"/qdEGArH3lKfFnAtYXMkSYk5wxuG.png"},{"n":"Google Play Movies","kind":"buy","logo":"/aZRENwYILujqs0RVOZutTh0BVGV.png"},{"n":"Fandango At Home","kind":"buy","logo":"/wpOt6x0dRxTrIzuBosto4LGd7E9.png"}]},"GB":{"link":"https://www.themo