{"overview":"ناتسوکی سوبارو، یک دانش‌آموز دبیرستانی معمولی، در راه بازگشت از خواربارفروشی به خانه است که خود را در دنیایی دیگر می‌یابد. در حالی که در این دنیای جدید گم‌گشته و سردرگم است و حتی چپ و راست را نمی‌شناسد، تنها کسی که به او کمک می‌کند دختری زیبا با موهای نقره‌ای است. سوبارو که مصمم است به نوعی محبت او را در نجات دادنش از ناامیدی جبران کند، موافقت می‌کند به دختر در پیدا کردن چیزی که به دنبالش است کمک کند.","tagline":"","runtime":25,"status":"Returning Series","seasons":[{"n":0,"name":"ویژه‌ها","ep":90,"y":2016,"poster":"/4Gsh6zCE6SYNlal3FW6scj3PkAz.jpg"},{"n":1,"name":"فصل 1","ep":85,"y":2016,"poster":"/nLgY9Ped6ABn7XPKT84RBKG2Lvm.jpg"}],"episodes":85,"crew":[],"countries":["JP"],"cast":[{"name":"小林裕介","role":"Subaru Natsuki (voice)","photo":"/y4ukKDSobZJNuB4H3k89hkrKCDC.jpg"},{"name":"高橋李依","role":"Emilia (voice)","photo":"/aeB7z0cBTASdjKOjQriBAO6hYq4.jpg"},{"name":"内山夕実","role":"Puck (voice)","photo":"/JvavoF3YOLCf4LHfl4XvYobANE.jpg"},{"name":"ری موراکاوا","role":"Ram (voice)","photo":"/pawIx7uhV1a2fAHjvTnrCP0KcHX.jpg"},{"name":"水瀬いのり","role":"Rem (voice)","photo":"/cqOrQDUbbQLKpujzcK47YqjFdNp.jpg"},{"name":"新井里美","role":"Beatrice (voice)","photo":"/v95wU1gpSLAOJS5yKFTxyheXAW2.jpg"}],"trailer":"P4l9d-rlD4o","watch":{"US":{"link":"https://www.themoviedb.org/tv/65942-re/watch?locale=US","p":[{"n":"Hulu","kind":"flatrate","logo":"/44uAnmSqvA4yBOdbPWN8YgQHjWm.png"},{"n":"Crunchyroll","kind":"flatrate","logo":"/uFL3c4Cq8M6WoLymlC5Y8bmGytV.png"},{"n":"Crunchyroll Amazon Channel","kind":"flatrate","logo":"/qHLLmKo7udRgiSnIASVTwP2IxfJ.png"},{"n":"Amazon Video","kind":"buy","logo":"/jn6TLbtaTZntTRX9UYucHJvpQx1.png"},{"n":"Apple TV Store","kind":"buy","logo":"/qdEGArH3lKfFnAtYXMkSYk5wxuG.png"},{"n":"Google Play Movies","kind":"buy","logo":"/aZRENwYILujqs0RVOZutTh0BVGV.png"}]},"GB":{"link":"https://www.themoviedb.org/tv/65942-re/watch?locale=GB","p":[{"n":"Crunchyroll","kind":"flatrate","logo":"/uFL3c4Cq8M6WoLymlC5Y8bmGytV.png"},{"n":"Crunchyroll Amazon Channel","ki