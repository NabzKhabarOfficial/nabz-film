{"overview":"The Harald Schmidt Show is a German late night talk show hosted on Sky Deutschland by comedian Harald Schmidt. The show first aired from 5 December 1995 to 23 December 2003 on Sat.1. Schmidt then moved his show to Das Erste as Harald Schmidt and Schmidt & Pocher, but he returned to Sat.1 on 13 September 2011. After cancellation on Sat.1, the show continued on Sky Deutschland in September 2012.","tagline":"","overview_en":"","tagline_en":"","runtime":43,"status":"Ended","seasons":[{"n":1,"name":"فصل 1","ep":128,"y":1995,"poster":"/cABrAWIZC4Jw6dKBvsqkvBmZzGP.jpg"},{"n":2,"name":"فصل 2","ep":167,"y":1996,"poster":""},{"n":3,"name":"فصل 3","ep":155,"y":1997,"poster":""},{"n":4,"name":"فصل 4","ep":166,"y":1998,"poster":"/cABrAWIZC4Jw6dKBvsqkvBmZzGP.jpg"},{"n":5,"name":"فصل 5","ep":171,"y":1999,"poster":"/cABrAWIZC4Jw6dKBvsqkvBmZzGP.jpg"},{"n":6,"name":"فصل 6","ep":170,"y":2000,"poster":""},{"n":7,"name":"فصل 7","ep":161,"y":2001,"poster":"/cABrAWIZC4Jw6dKBvsqkvBmZzGP.jpg"},{"n":8,"name":"فصل 8","ep":179,"y":2002,"poster":"/cABrAWIZC4Jw6dKBvsqkvBmZzGP.jpg"},{"n":9,"name":"فصل 9","ep":67,"y":2003,"poster":"/cABrAWIZC4Jw6dKBvsqkvBmZzGP.jpg"},{"n":10,"name":"فصل 10","ep":1,"y":2004,"poster":""},{"n":11,"name":"فصل 11","ep":1,"y":2005,"poster":""},{"n":12,"name":"فصل 12","ep":1,"y":2008,"poster":""},{"n":13,"name":"فصل 13","ep":1,"y":2009,"poster":""},{"n":14,"name":"فصل 14","ep":1,"y":2010,"poster":""}],"episodes":1369,"crew":[],"countries":["DE"],"cast":[{"name":"Harald Schmidt","role":"Self - Host","photo":"/dPlgKtBPmmbQJfbovq43GzE3fxj.jpg"},{"name":"Manuel Andrack","role":"Self - Co-Host","photo":"/1AD74ehAmUcDJeIBG2L5sSru7aM.jpg"},{"name":"Helmut Zerlett","role":"Self - Band Leader","photo":"/r8gKau9pzIwtpvGyxrwBXAzjRAa.jpg"}],"trailer":"","watch":{},"recs":["s1636"],"tmdb":"https://www.themoviedb.org/tv/40605"}