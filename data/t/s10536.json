{"overview":"The Mike Douglas Show is an American daytime television talk show hosted by Mike Douglas that originally aired only in the Cleveland area during much of its first two years on the air. It then went into syndication in 1963 and remained on television until 1982. It was distributed by Westinghouse Broadcasting and for much of its run, originated from studios of two of the company's TV stations in Cleveland and Philadelphia.","tagline":"","overview_en":"","tagline_en":"","runtime":60,"status":"Returning Series","seasons":[{"n":1,"name":"فصل 1","ep":36,"y":1961,"poster":""},{"n":2,"name":"فصل 2","ep":15,"y":null,"poster":""},{"n":3,"name":"فصل 3","ep":48,"y":1963,"poster":""},{"n":4,"name":"فصل 4","ep":55,"y":null,"poster":""},{"n":5,"name":"فصل 5","ep":43,"y":null,"poster":""},{"n":6,"name":"فصل 6","ep":54,"y":null,"poster":""},{"n":7,"name":"فصل 7","ep":57,"y":1970,"poster":""},{"n":8,"name":"فصل 8","ep":42,"y":1968,"poster":""},{"n":9,"name":"فصل 9","ep":53,"y":null,"poster":""},{"n":10,"name":"فصل 10","ep":60,"y":1971,"poster":""},{"n":11,"name":"فصل 11","ep":64,"y":1971,"poster":""},{"n":12,"name":"فصل 12","ep":89,"y":null,"poster":""},{"n":13,"name":"فصل 13","ep":57,"y":1973,"poster":""},{"n":14,"name":"فصل 14","ep":62,"y":null,"poster":""},{"n":15,"name":"فصل 15","ep":90,"y":null,"poster":""},{"n":16,"name":"فصل 16","ep":77,"y":null,"poster":""},{"n":17,"name":"فصل 17","ep":70,"y":1977,"poster":""},{"n":18,"name":"فصل 18","ep":65,"y":1978,"poster":""},{"n":19,"name":"فصل 19","ep":46,"y":null,"poster":""},{"n":20,"name":"فصل 20","ep":16,"y":null,"poster":""},{"n":22,"name":"فصل 22","ep":1,"y":null,"poster":""}],"episodes":1100,"crew":[],"crew_en":[],"countries":[],"cast":[{"name":"Mike Douglas","role":"Self - Host","photo":"/rHAgefQtE9EYTcY7KQyS0Om9s7e.jpg"}],"trailer":"","watch":{},"recs":["s63770","s14981"],"tmdb":"https://www.themoviedb.org/tv/10536"}